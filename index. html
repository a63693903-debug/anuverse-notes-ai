  <div class="features">

    <div class="card">
      <div class="icon">📝</div>
      <h3>AI Summary</h3>
      <p>Convert long notes into easy-to-understand summaries.</p>
    </div>

    <div class="card">
      <div class="icon">⭐</div>
      <h3>Key Points</h3>
      <p>Find the most important concepts from your notes.</p>
    </div>

    <div class="card">
      <div class="icon">💬</div>
      <h3>Ask AI</h3>
      <p>Ask questions about your uploaded study material.</p>
    </div>

