<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AnuVerse Notes AI</title>
<style>body{font-family:sans-serif;background:#f5f0ff;padding:12px}h2{text-align:center;color:#7c3aed}.card{background:#fff;padding:16px;border-radius:20px}textarea{width:100%;height:110px;border-radius:14px;border:2px solid #c4b5fd;padding:14px;font-size:16px}button{background:#7c3aed;color:#fff;border:none;padding:18px;width:100%;border-radius:14px;font-size:18px;font-weight:bold;margin-top:12px;cursor:pointer}#output{background:#f8f7ff;padding:16px;border-radius:14px;margin-top:14px;white-space:pre-wrap;line-height:1.7}</style>
</head>
<body>
<h2>🚀 AnuVerse Notes AI</h2>
<div class="card">
<textarea id="q" placeholder="Koi bhi topic likho..."></textarea>
<button type="button" onclick="ask()" id="btn">✨ Ask From Real AI</button>
<div id="output">Answer yaha ayega...</div>
</div>
<script>
async function ask(){
 var q=document.getElementById('q').value.trim();
 var out=document.getElementById('output');
 if(!q) return;
 out.innerText="⏳ '"+q+"' ke liye likh raha hu...";
 try{
  let p="Define "+q+" in 80 words. Format: Definition: 1 line. 3 Points: - - - . Trick: 1 line. Tip: 1 line. Direct answer, no reasoning.";
  let r=await fetch("https://text.pollinations.ai/"+encodeURIComponent(p)+"?model=openai-fast");
  let t=await r.text();
  if(t.includes("exhausted")||t.includes("UpstreamError")){
    let r2=await fetch("https://text.pollinations.ai/"+encodeURIComponent("What is "+q+"? 60 words")+"?model=openai-fast");
    t=await r2.text();
  }
  if(t.includes("Free limit")) out.innerText="20 sec ruko fir click karo, limit tha.";
  else out.innerText=t.replaceAll("**","").replaceAll("*","");
 }catch(e){ out.innerText="Ek baar aur click karo, network slow tha."; }
}
</script>
</body>
</html>