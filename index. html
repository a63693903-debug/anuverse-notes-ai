  <div class="upload">

    <div class="upload-icon">📄</div>

    <h3>Upload Your Notes</h3>

    <p>
      Start with a PDF and let AnuVerse AI help you study smarter.
    </p>

    <label class="upload-btn">
      Choose PDF
      <input id="pdfInput" type="file" accept=".pdf,application/pdf">
