<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AnuVerse Notes AI - V3</title>
<style>
body{font-family:sans-serif;background:#f3e8ff;padding:15px}
.card{background:white;padding:20px;border-radius:15px;margin-top:20px}
button{background:#7c3aed;color:white;padding:15px 25px;border:none;border-radius:12px;width:100%;font-size:18px;font-weight:bold}
textarea{width:100%;height:150px;padding:10px;border-radius:10px;border:2px solid #c4b5fd}
#output{background:#ede9fe;padding:15px;border-radius:10px;margin-top:15px;min-height:80px;white-space:pre-wrap}
</style>
</head>
<body>
<h2 style="text-align:center;color:#6d28d9">🚀 AnuVerse Notes AI - V3 Fixed</h2>
<p style="text-align:center">Built by Anushka | Salon</p>

<div class="card">
<textarea id="notes" placeholder="Yaha notes paste karo...">Photosynthesis is the process by which plants make their own food using sunlight, water and carbon dioxide. It happens in chloroplasts. Chlorophyll is the green pigment. Light reaction happens in day, dark reaction at night. This is very important for Class 10 Science exam.</textarea>
<button onclick="makeSummary()">✨ AI Summary Banao - V3</button>
<div id="output">Yaha tumhara AI summary ayega...</div>
</div>

<script>
function makeSummary(){
  let text = document.getElementById('notes').value;
  if(text.length < 10){ alert('Pehle notes likho!'); return; }
  let sentences = text.split('.');
  let summary = "📌 SUMMARY:\n\n";
  summary += "1. " + sentences[0] + ".\n\n";
  summary += "2. Important Points: " + text.substring(0,120) + "...\n\n";
  summary += "3. Exam Ke Liye: Ye topic Class 10 Science ke liye bahut important hai.\n\n";
  summary += "✅ 50 Pages = 2 Min Me Ready!\n\nMade by Anushka - Salon, Raebareli";

  document.getElementById('output').innerText = summary;
  document.getElementById('output').scrollIntoView({behavior:'smooth'});
  // Vibration for mobile
  if(navigator.vibrate) navigator.vibrate(100);
}
</script>
</body>
</html>Built by Anushka
<p style="font-size:13px;color:#555;margin-top:4px">Engineering First Year Student at CSE AIML</p>