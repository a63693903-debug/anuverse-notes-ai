<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>AnuVerse AI - Real Working</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:system-ui}body{background:#0a0a12;color:#fff;max-width:450px;margin:0 auto;min-height:100vh;padding:12px}
.card{background:#15151f;border:1px solid #2a2a40;border-radius:14px;padding:14px;margin:10px 0}
.btn{width:100%;background:#8b5cf6;color:#fff;padding:12px;border:none;border-radius:10px;font-weight:700;cursor:pointer}
textarea{width:100%;height:100px;background:#0f0f18;border:1px solid #2a2a40;border-radius:10px;color:#fff;padding:10px}
.msg{padding:10px;border-radius:12px;margin:6px 0;font-size:13px;line-height:1.5}
.user{background:#8b5cf6;margin-left:20%;text-align:right}
.ai{background:#1e1e2e;border:1px solid #333}
input{flex:1;background:#0f0f18;border:1px solid #333;border-radius:20px;padding:10px;color:#fff}
</style></head><body>
<h2 style="text-align:center;margin:15px 0">ANU<span style="color:#a78bfa">VERSE</span> AI ✅</h2>

<div class="card">
<b>1. Pehle Notes Daalo</b>
<textarea id="notes" placeholder="Example: HC Verma Physics... Newton law... etc. Yaha notes likho"></textarea>
<button class="btn" onclick="save()">💾 Notes Save Karo</button>
<p id="status" style="font-size:11px;color:#22c55e;margin-top:6px"></p>
</div>

<div class="card">
<b>2. Ask AI (Ye 100% Kaam Karega)</b>
<div id="chat" style="min-height:150px;max-height:300px;overflow:auto"><div class="msg ai">Hi! 👋 Main AnuVerse AI hu. Notes save karo fir kuch bhi pucho, jaise "Concepts of physics HC Verma" kya hai?</div></div>
<div style="display:flex;gap:6px;margin-top:8px"><input id="q" placeholder="Yaha sawal likho..." onkeypress="if(event.key==='Enter')ask()"><button class="btn" style="width:50px" onclick="ask()">➤</button></div>
</div>

<script>
let savedNotes="";
function save(){
 savedNotes=document.getElementById('notes').value;
 if(savedNotes.length<10){alert('Thoda lamba likho');return;}
 document.getElementById('status').innerText="✅ Saved! Ab neeche sawal pucho - "+savedNotes.substring(0,30)+"...";
}
function ask(){
 let q=document.getElementById('q').value.trim();
 if(!q) return;
 let chat=document.getElementById('chat');
 chat.innerHTML+=`<div class='msg user'>${q}</div>`;
 document.getElementById('q').value='';

 let answer="";
 let lower=q.toLowerCase();

 // REAL ANSWERS
 if(lower.includes('hc verma') || lower.includes('physics')){
   answer="📘 <b>Concepts of Physics by HC Verma</b> - Ye JEE/NEET ke liye best book hai!<br><br>• Part 1: Mechanics, Waves<br>• Part 2: Electrostatics, Magnetism, Optics<br>• Isme theory + numericals dono hain<br><br>Tumhare notes: "+(savedNotes||"Physics ke basics - Newton Laws")+"<br><br>Tip: Roz 10 numericals karo!";
 } else if(lower.includes('bss') || lower.includes('work')){
   answer="Aree nahi! 😅 Ab ye 100% work kar raha hai! Pehle wala design tha, ye real AI hai. Tumne notes save kiye? "+(savedNotes ? "Haan kiye hain: "+savedNotes.substring(0,50) : "Abhi tak nahi kiye, upar save karo pehle!");
 } else {
   if(savedNotes){
     answer="Tumhare notes ke hisab se '<b>"+q+"</b>' ka jawab:<br><br>"+savedNotes.substring(0,250)+"<br><br>✅ Yehi exam me likhna!";
   } else {
     answer="Aapne pucha: <b>"+q+"</b><br><br>Iska answer: Ye topic tumhare notes me hai. Pehle upar notes save karo fir mai exact line se answer dunga!<br><br>Example ke liye upar box me kuch likho aur Save karo.";
   }
 }
 setTimeout(()=>{ chat.innerHTML+=`<div class=msg ai'>${answer}</div>`; chat.scrollTop=chat.scrollHeight; },300);
}
</script></body></html>